# ==============================================================================
# Vanix IoT Sentinel - Root .gitignore
# ==============================================================================

# --- Node.js & Dependencies ---
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Environment & Secret Keys ---
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
mobile/.env*

# --- Database & Runtime State ---
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal
backend/data/*.sqlite*
backend/data/*.sqlite3
*.db-journal
*.sqlite-journal

# --- Expo & Mobile Build Artifacts ---
.expo/
*/.expo/
web-build/
expo-env.d.ts
.metro-health-check*
mobile/dist/

# --- Native Mobile Binaries ---
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.kotlin/
/ios/
/android/

# --- Testing & Coverage ---
coverage/
.nyc_output/

# --- IDE & Editor Artifacts ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- TypeScript ---
*.tsbuildinfo
